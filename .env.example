# Corporate proxy support for building the Docker images from behind a
# proxy that intercepts TLS. Preferred: point this at your proxy's root CA
# and it'll be installed and trusted for the build -- no need to disable
# certificate verification.
CORP_PROXY_CA_URL=
# Last resort only, if installing the CA above isn't possible: disables
# certificate verification for the build entirely. Leave false otherwise.
CORP_PROXY_INSECURE_SSL=false

# Image tags
STIG_IMAGE_TAG=latest
NEO4J_IMAGE_TAG=latest

# Neo4j container auth (NEO4J_AUTH format: user/password)
NEO4J_AUTH=neo4j/<your-neo4j-password>

# Neo4j connection
NEO4J_HOST=bolt://<neo4j-host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j

# Set to true to have the STIG API server connect to Neo4j on startup using
# the NEO4J_HOST/USER/PASSWORD above, instead of requiring a connection to
# be entered manually in the UI. Defaults to false.
NEO4J_AUTOCONNECT=false
